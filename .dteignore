# Globs the dte scanner skips (in addition to .git and the decisions dir).
node_modules
vendor
dist
build
target
src-tauri/target
# Git-ignored local output: Tauri's generated schemas, locally generated sample data.
src-tauri/gen
sample-data
__pycache__
# Agent worktrees hold full repo copies; scanning them double-counts everything.
.claude
# Inside a worktree .git is a file, which the scanner's .git-directory skip misses.
.git
# Generated dev-graph mirror + coverage output.
.dev
coverage
# Bundled sample data, not artifacts that serve a decision.
demo-vault
# The vendored DTE tool: its dte: tokens belong to DTE's own tree, not this one.
tools/dte.py
*.min.js
*.lock
*.png
*.jpg
*.gif
*.svg
*.ico
*.pdf
*.woff
*.woff2
*.ttf
*.ics
# Vendored DTE rule text: its citations are DTE's tree, not this one.
dte-rules/*

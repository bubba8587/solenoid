{
  "name": "solenoid",
  "private": true,
  "version": "1.5.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/check-dist-classnames.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:live": "tauri dev --config src-tauri/tauri.live.conf.json",
    "desktop:debug": "cargo build --manifest-path src-tauri/Cargo.toml",
    "desktop:launchers": "node scripts/install-linux-launchers.mjs",
    "release:desktop": "node scripts/release-build.mjs",
    "plugin:build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config obsidian-plugin/vite.config.ts",
    "plugin:dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config obsidian-plugin/vite.config.ts --watch",
    "plugin:rig": "node scripts/obsidian-rig.mjs",
    "plugin:export": "node scripts/export-plugin-source.mjs",
    "run-graph": "tsx scripts/run-graph.ts",
    "copy-inventory": "tsx scripts/copy-inventory.ts",
    "validate-graph": "tsx scripts/validate-graph.ts",
    "ai-grounding": "tsx scripts/ai-grounding.ts",
    "ai-prompt": "tsx scripts/ai-prompt.ts",
    "search-samples": "node scripts/search-samples-table.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@formulajs/formulajs": "4.6.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@types/katex": "^0.16.8",
    "@types/papaparse": "^5.5.2",
    "@xyflow/react": "^12.12.0",
    "chrono-node": "^2.10.2",
    "colord": "^2.10.0",
    "dompurify": "^3.4.16",
    "elkjs": "^0.12.0",
    "katex": "^0.19.0",
    "knap": "^0.6.0",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "rete": "^2.0.6",
    "rete-engine": "^2.1.1",
    "web-worker": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "estree-walker": "3.0.3",
    "magic-string": "0.30.21",
    "obsidian": "^1.14.4",
    "postcss": "8.5.29",
    "puppeteer-core": "^25.13.0",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}

{
  "name": "solenoid",
  "private": true,
  "version": "1.5.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsrs && vite build",
    "postbuild": "node scripts/check-dist-classnames.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:live": "tauri dev --config src-tauri/tauri.live.conf.json",
    "desktop:debug": "cargo build --manifest-path src-tauri/Cargo.toml",
    "desktop:launchers": "node scripts/install-linux-launchers.mjs",
    "release:desktop": "node scripts/release-build.mjs",
    "plugin:build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config obsidian-plugin/vite.config.ts",
    "plugin:dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build --config obsidian-plugin/vite.config.ts --watch",
    "plugin:rig": "node scripts/obsidian-rig.mjs",
    "plugin:export": "node scripts/export-plugin-source.mjs",
    "run-graph": "node scripts/vite-run.mjs scripts/run-graph.ts",
    "build:cli": "vite build --config scripts/run-graph.vite.config.ts",
    "postbuild:cli": "node scripts/cli-smoke.mjs",
    "copy-inventory": "node scripts/vite-run.mjs scripts/copy-inventory.ts",
    "validate-graph": "node scripts/vite-run.mjs scripts/validate-graph.ts",
    "ai-grounding": "node scripts/vite-run.mjs scripts/ai-grounding.ts",
    "ai-prompt": "node scripts/vite-run.mjs scripts/ai-prompt.ts",
    "search-samples": "node scripts/search-samples-table.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:opt": "node scripts/build-wasm.mjs --opt",
    "test:core": "cargo test --manifest-path crates/solenoid-core/Cargo.toml --target-dir crates/solenoid-core/target"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@types/katex": "^0.16.8",
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "0.0.83",
    "chrono-node": "^2.10.2",
    "colord": "^2.10.0",
    "dompurify": "^3.4.16",
    "elkjs": "^0.12.0",
    "katex": "^0.19.0",
    "knap": "^0.6.0",
    "marked": "^18.1.0",
    "pele": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "web-worker": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "estree-walker": "3.0.3",
    "magic-string": "0.30.21",
    "obsidian": "^1.14.4",
    "papaparse": "^5.7.0",
    "postcss": "8.5.29",
    "puppeteer-core": "^25.13.0",
    "rollup-plugin-license": "^3.7.1",
    "three": "0.186.1",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

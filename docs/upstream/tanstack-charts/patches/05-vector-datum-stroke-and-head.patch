+
+/** Vector whose closed, filled head covers the shaft from its base to the tip. */
+function filledVectorGeometry({
+  key,
+  x1,
+  y1,
+  x2,
+  y2,
+  headLength,
+  headAngle,
+  style,
+  className,
+}: ArrowGeometryOptions): SceneGroup {
+  const angle = Math.atan2(y2 - y1, x2 - x1)
+  const shaft = Math.max(
+    0,
+    1 -
+      (headLength * Math.cos(headAngle)) / (Math.hypot(x2 - x1, y2 - y1) || 1),
+  )
+  const corner = (side: number) =>
+    [
+      x2 + Math.cos(angle + Math.PI + side * headAngle) * headLength,
+      y2 + Math.sin(angle + Math.PI + side * headAngle) * headLength,
+    ] as const
+
+  return {
+    kind: 'group',
+    key,
+    className,
+    ariaHidden: true,
+    children: [
+      {
+        kind: 'rule',
+        key: `${key}:shaft`,
+        className: 'ts-chart__arrow-shaft',
+        x1,
+        y1,
+        x2: x1 + (x2 - x1) * shaft,
+        y2: y1 + (y2 - y1) * shaft,
+        style,
+      },
+      {
+        kind: 'area',
+        key: `${key}:head`,
+        className: 'ts-chart__arrow-head',
+        points: [corner(-1), [x2, y2], corner(1)],
+        style: { fill: style.stroke, fillOpacity: style.strokeOpacity },
+      },
+    ],
+  }
+}

+ */
+export function contourLines<TDatum>(
+  source: Iterable<TDatum>,
+  options: ContourLinesOptions<NoInfer<TDatum>>,
+): ChartMark<never, never, never> {
+  const { width, height } = options
+  const smooth = options.smooth ?? true
+  const prepared = generateContours(
+    source,
+    options,
+    'contourLines',
+    false,
+    (geometry, grid) => {
+      const lines = contourIsolines(
+        geometry.coordinates,
+        grid,
+        geometry.value,
+        smooth,
+      )
+      return lines.length ? lines : undefined
+    },
+  )
+  const derivedData = prepared.map(({ datum }) => datum)
+  const colorValues = channelValues(
+    derivedData,
+    options.color,
+    (datum) => datum.value,
+  )
+

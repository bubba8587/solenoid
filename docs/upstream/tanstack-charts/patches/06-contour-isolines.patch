+    ])
+  })
+
+  it('keeps interior rings closed on the smoothed fill crossings', () => {
+    const values = [
+      0, 0, 0, 0, 0, 0, 4, 6, 4, 0, 0, 6, 8, 6, 0, 0, 4, 6, 4, 0, 0, 0, 0, 0, 0,
+    ]
+    const grid = { values, width: 5, height: 5 }
+    const generator = contours().size([5, 5])
+    const rings = generator.smooth(false).contour(values, 3).coordinates
+    const fill = generator.smooth(true).contour(values, 3).coordinates
+    const lines = contourIsolines(rings, grid, 3, true)
+
+    expect(lines).toEqual([fill[0]![0]])
+    expect(lines[0]![0]).toEqual(lines[0]!.at(-1))
+  })
+
+  it('omits edges in marching cells beside missing samples', () => {
+    const values = [
+      0,
+      0,
+      0,
+      0,
+      0,
+      0,
+      4,
+      6,
+      4,
+      0,
+      0,
+      6,
+      Number.NaN,
+      6,
+      0,
+      0,
+      4,
+      6,
+      4,
+      0,
+      0,
+      0,
+      0,
+      0,
+      0,
+    ]
+    const grid = { values, width: 5, height: 5 }
+    const generator = contours().size([5, 5])
+    const rings = generator.smooth(false).contour(values, 5).coordinates
+    const fill = generator.smooth(true).contour(values, 5).coordinates
+    const lines = contourIsolines(rings, grid, 5, true)
+    const fillPoints = new Set(
+      fill.flat(2).map((point) => JSON.stringify(point)),
+    )
+
+    expect(lines).toHaveLength(4)
+    for (const line of lines) {
+      expect(line).toHaveLength(3)
+      expect(line[0]).not.toEqual(line.at(-1))
+      for (const point of line) {
+        expect(fillPoints.has(JSON.stringify(point))).toBe(true)
+        expect(Math.hypot(point[0]! - 2.5, point[1]! - 2.5)).toBeGreaterThan(1)
+      }
+    }
+  })
+})
diff --git a/packages/charts-core/src/spatial-contour-internal.ts b/packages/charts-core/src/spatial-contour-internal.ts
index 7d42f99..1045363 100644
--- a/packages/charts-core/src/spatial-contour-internal.ts
+++ b/packages/charts-core/src/spatial-contour-internal.ts
@@ -105,3 +105,91 @@ function invalidContourPoint(): never {
     'Contour coordinates must project to finite two-dimensional points',
   )
 }
+
+/**
+ * Splits unsmoothed scalar-grid rings into iso-lines. An edge survives only
+ * when every in-grid sample of its marching cell is finite and at least one
+ * endpoint lies inside the grid border, so fill edges along the grid border and
+ * missing cells are removed. Unbroken rings stay closed by repeating their
+ * first point.
+ */
+export function contourIsolines(
+  coordinates: readonly ContourPolygon[],
+  grid: {
+    readonly values: readonly number[]
+    readonly width: number
+    readonly height: number
+  },
+  level: number,
+  smooth: boolean,
+): readonly ContourRing[] {
+  const { values, width, height } = grid
+  const onBorder = (point: ContourPoint) =>
+    point[0] === 0 ||
+    point[0] === width ||
+    point[1] === 0 ||
+    point[1] === height
+  const complete = (start: ContourPoint, end: ContourPoint) => {
+    const column = Math.floor((start[0]! + end[0]!) / 2 - 0.5)
+    const row = Math.floor((start[1]! + end[1]!) / 2 - 0.5)
+    for (let y = row; y <= row + 1; y++) {
+      for (let x = column; x <= column + 1; x++) {
+        if (x < 0 || x >= width || y < 0 || y >= height) continue
+        if (!Number.isFinite(values[y * width + x])) return false
+      }
+    }
+    return true
+  }
+  // Matches d3-contour's linear smoothing so lines share the fill's crossings.
+  const interpolate = (position: number, v0: number, v1: number) =>
+    position + (level - v0) / (v1 - v0) - 0.5
+  const place = (point: ContourPoint): ContourPoint => {
+    const x = point[0]!
+    const y = point[1]!
+    if (!smooth) return [x, y]
+    const column = Math.floor(x)
+    const row = Math.floor(y)
+    const value = values[row * width + column]!
+    if (x > 0 && x < width && column === x) {
+      return [interpolate(x, values[row * width + column - 1]!, value), y]
+    }
+    if (y > 0 && y < height && row === y) {
+      return [x, interpolate(y, values[(row - 1) * width + column]!, value)]
+    }
+    return [x, y]
+  }
+
+  return coordinates.flatMap((polygon) =>
+    polygon.flatMap((ring) => {
+      const points =
+        ring.length > 1 &&
+        ring[0]![0] === ring.at(-1)![0] &&
+        ring[0]![1] === ring.at(-1)![1]
+          ? ring.slice(0, -1)
+          : ring
+      const count = points.length
+      const kept = points.map((start, index) => {
+        const end = points[(index + 1) % count]!
+        return (!onBorder(start) || !onBorder(end)) && complete(start, end)
+      })
+      const first = kept.indexOf(false)
+      if (first === -1) {
+        const closed = points.map(place)
+        return [[...closed, closed[0]!]]
+      }
+      const lines: ContourPoint[][] = []
+      let line: ContourPoint[] = []
+      for (let offset = 1; offset <= count; offset++) {
+        const index = (first + offset) % count
+        if (kept[index]) {
+          if (!line.length) line.push(place(points[index]!))
+          line.push(place(points[(index + 1) % count]!))
+        } else if (line.length) {
+          lines.push(line)
+          line = []
+        }
+      }
+      return lines
+    }),
+  )
+}

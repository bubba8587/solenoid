+function haloStyle(halo: TextOptions<unknown>['halo']): SceneStyle | undefined {
+  if (!halo) return undefined
+  const options = halo === true ? {} : halo
+  const strokeWidth =
+    typeof options.strokeWidth === 'number' &&
+    Number.isFinite(options.strokeWidth) &&
+    options.strokeWidth >= 0
+      ? options.strokeWidth
+      : 3
+  if (strokeWidth === 0 || options.strokeOpacity === 0) return undefined
+  return {
+    fill: 'none',
+    stroke: options.stroke ?? 'var(--ts-chart-text-halo, Canvas)',
+    strokeOpacity: options.strokeOpacity,
+    strokeWidth,
+    lineJoin: 'round',
+  }

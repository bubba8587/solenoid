+function haloScene(
+  options: Pick<Parameters<typeof text<Row>>[1] & {}, 'halo' | 'states'> = {},
+): ChartScene {
+  const rows: Row[] = [
+    { id: 'a', x: 2, y: 3, label: 'Alpha' },
+    { id: 'b', x: 8, y: 7, label: 'Beta' },
+  ]
+  return createChartScene(
+    defineChart({
+      marks: [
+        text(rows, { x: 'x', y: 'y', text: 'label', key: 'id', ...options }),
+      ],
+      ...linearAxes([0, 10], [0, 10]),
+    }),
+    { width: 480, height: 260 },
+  )
+}
+
+interface Row {
+  id: string
+  x: number
+  y: number
+  label: string
+}
+
+function textLabels(scene: ChartScene): SceneLabel[] {
+  const textGroup = flatten(scene.nodes).find(
+    (node) => node.className === 'ts-chart__text',
+  )
+  return textGroup?.kind === 'group'
+    ? textGroup.children.filter(
+        (node): node is SceneLabel => node.kind === 'label',
+      )
+    : []
+}
+
 function flatten(nodes: readonly SceneNode[]): SceneNode[] {
   return nodes.flatMap((node) =>
     node.kind === 'group' ? [node, ...flatten(node.children)] : [node],

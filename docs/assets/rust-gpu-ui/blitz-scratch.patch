+    /// `text-overflow: ellipsis` on a clipped box whose first line overflows it: where to cut the
+    /// text (after the last whole glyph that leaves room) and the "…" glyph to draw there.
+    fn ellipsis_plan(&self, layout: &parley::Layout<blitz_dom::node::TextBrush>) -> Option<EllipsisPlan> {
+        use parley::PositionedLayoutItem;
+        use skrifa::MetadataProvider as _;
+        use style::values::specified::text::TextOverflowSide;
+        if !matches!(self.style.get_text().text_overflow.second, TextOverflowSide::Ellipsis) {
+            return None;
+        }
+        if matches!(
+            self.style.get_box().overflow_x,
+            style::values::computed::Overflow::Visible
+        ) {
+            return None;
+        }
+        let avail = self.frame.content_box.width() as f32;
+        let line = layout.lines().next()?;
+        let mut first_run = None;
+        let mut ends = Vec::new();
+        for item in line.items() {
+            if let PositionedLayoutItem::GlyphRun(glyph_run) = item {
+                for glyph in glyph_run.positioned_glyphs() {
+                    ends.push(glyph.x + glyph.advance);
+                }
+                if first_run.is_none() {
+                    first_run = Some(glyph_run);
+                }
+            }
+        }
+        if ends.iter().copied().fold(0.0, f32::max) <= avail + 0.5 {
+            return None;
         }
+        let glyph_run = first_run?;
+        let run = glyph_run.run();
+        let font = run.font().clone();
+        let font_size = run.font_size();
+        let font_ref = skrifa::FontRef::from_index(font.data.as_ref(), font.index).ok()?;
+        let glyph = font_ref.charmap().map('\u{2026}')?;
+        let advance = font_ref
+            .glyph_metrics(skrifa::instance::Size::new(font_size), skrifa::instance::LocationRef::default())
+            .advance_width(glyph)?;
+        let limit = avail - advance;
+        let cut = ends.iter().copied().filter(|end| *end <= limit).fold(0.0, f32::max);
+        let coords: &[i16] = bytemuck::cast_slice(run.normalized_coords());
+        Some(EllipsisPlan {
+            font,
+            font_size,
+            coords: coords.to_vec(),
+            glyph: glyph.to_u32(),
+            cut,
+            baseline: glyph_run.baseline(),
+            color: self.style.clone_color().as_srgb_color(),
+        })
     }
 

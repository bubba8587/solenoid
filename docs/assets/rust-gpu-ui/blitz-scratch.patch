+/// The text a closed `<select>` shows: its selected option's, else its first option's.
+fn selected_option_text(doc: &BaseDocument, select_id: NodeId) -> String {
+    let mut first = None;
+    let mut selected = None;
+    let mut stack = vec![select_id];
+    while let Some(id) = stack.pop() {
+        let node = &doc.nodes[id];
+        if let Some(el) = node.data.downcast_element() {
+            if *el.name.local == *"option" {
+                let text = node.text_content().trim().to_string();
+                if el.has_attr(local_name!("selected")) && selected.is_none() {
+                    selected = Some(text.clone());
+                }
+                if first.is_none() {
+                    first = Some(text);
+                }
+                continue;
+            }
+        }
+        stack.extend(node.children.iter().rev().copied());
+    }
+    selected.or(first).unwrap_or_default()
+}

+/// Substitutes `var(--name[, fallback])` in an SVG attribute with the element's computed custom
+/// property, since the SVG renderer only sees the serialized markup.
+fn resolve_vars(value: &str, style: &style::properties::ComputedValues) -> String {
+    let mut out = String::new();
+    let mut rest = value;
+    while let Some(i) = rest.find("var(--") {
+        out.push_str(&rest[..i]);
+        let after = &rest[i + 4..];
+        let mut depth = 1;
+        let mut end = None;
+        for (j, c) in after.char_indices() {
+            match c {
+                '(' => depth += 1,
+                ')' => {
+                    depth -= 1;
+                    if depth == 0 {
+                        end = Some(j);
+                        break;
+                    }
+                }
+                _ => {}
+            }
+        }
+        let Some(end) = end else {
+            out.push_str(&rest[i..]);
+            return out;
+        };
+        let inner = &after[..end];
+        let (name, fallback) = match inner.find(',') {
+            Some(k) => (inner[..k].trim(), Some(inner[k + 1..].trim())),
+            None => (inner.trim(), None),
+        };
+        let atom = style::Atom::from(name.trim_start_matches("--"));
+        let resolved = style
+            .custom_properties()
+            .get_for_cssom(&atom)
+            .and_then(|v| v.as_universal())
+            .map(|v| v.css_text().trim().to_string())
+            .filter(|v| !v.is_empty())
+            .or_else(|| fallback.map(|f| resolve_vars(f, style)));
+        out.push_str(resolved.as_deref().unwrap_or("none"));
+        rest = &after[end + 1..];
+    }
+    out.push_str(rest);
+    out
+}

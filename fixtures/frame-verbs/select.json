{
 "verb": "select",
 "cases": [
  {
   "name": "keeps the named columns in the given order",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2
       ]
      },
      {
       "name": "b",
       "type": "string",
       "values": [
        "x",
        "y"
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "select",
    "columns": [
     "b",
     "a"
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "b",
      "type": "string",
      "values": [
       "x",
       "y"
      ]
     },
     {
      "name": "a",
      "type": "number",
      "values": [
       1,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "an unknown column errors",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "select",
    "columns": [
     "nope"
    ]
   },
   "expectError": "#REF!"
  },
  {
   "name": "a repeated name keeps the first occurrence only",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1
       ]
      },
      {
       "name": "b",
       "type": "number",
       "values": [
        2
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "select",
    "columns": [
     "a",
     "a",
     "b"
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "a",
      "type": "number",
      "values": [
       1
      ]
     },
     {
      "name": "b",
      "type": "number",
      "values": [
       2
      ]
     }
    ]
   }
  },
  {
   "name": "a picked column keeps its unit and format",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "k",
       "type": "string",
       "values": [
        "b",
        "a",
        "b"
       ],
       "format": {
        "format": "decimal",
        "unit": "none",
        "decimalDigits": 2,
        "decimalMode": "places"
       }
      },
      {
       "name": "d",
       "type": "number",
       "values": [
        3,
        1,
        2
       ],
       "unit": {
        "dim": {
         "length": 1
        },
        "display": "km"
       },
       "format": {
        "format": "decimal",
        "unit": "none",
        "decimalDigits": 1,
        "decimalMode": "places"
       }
      },
      {
       "name": "w",
       "type": "number",
       "values": [
        30,
        10,
        null
       ],
       "unit": {
        "dim": {
         "mass": 1
        },
        "display": "kg"
       }
      },
      {
       "name": "n",
       "type": "number",
       "values": [
        7,
        8,
        9
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "select",
    "columns": [
     "w",
     "d",
     "d"
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "w",
      "type": "number",
      "values": [
       30,
       10,
       null
      ],
      "unit": {
       "dim": {
        "mass": 1
       },
       "display": "kg"
      }
     },
     {
      "name": "d",
      "type": "number",
      "values": [
       3,
       1,
       2
      ],
      "unit": {
       "dim": {
        "length": 1
       },
       "display": "km"
      },
      "format": {
       "format": "decimal",
       "unit": "none",
       "decimalDigits": 1,
       "decimalMode": "places"
      }
     }
    ]
   }
  }
 ]
}

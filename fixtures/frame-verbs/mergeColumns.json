{
 "verb": "mergeColumns",
 "cases": [
  {
   "name": "merge text, numbers, dates and logicals",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "k",
       "type": "string",
       "values": [
        "a,b",
        null,
        "c",
        "d,e,f",
        null
       ]
      },
      {
       "name": "v",
       "type": "number",
       "values": [
        1.5,
        null,
        3,
        null,
        -2
       ]
      },
      {
       "name": "d",
       "type": "date",
       "values": [
        45000,
        null,
        45292.5,
        45001,
        null
       ]
      },
      {
       "name": "f",
       "type": "logical",
       "values": [
        true,
        null,
        false,
        null,
        null
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "mergeColumns",
    "columns": [
     "k",
     "v",
     "d",
     "f"
    ],
    "separator": " | ",
    "name": "all"
   },
   "expect": {
    "columns": [
     {
      "name": "all",
      "type": "string",
      "values": [
       "a,b | 1.5 | 15-Mar-2023 | TRUE",
       " |  |  | ",
       "c | 3 | 01-Jan-2024 | FALSE",
       "d,e,f |  | 16-Mar-2023 | ",
       " | -2 |  | "
      ]
     }
    ]
   }
  },

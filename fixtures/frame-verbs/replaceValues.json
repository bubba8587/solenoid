{
 "verb": "replaceValues",
 "cases": [
  {
   "name": "cell mode replaces whole cells; numbers match numerically (\"5\" hits 5); nulls untouched",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "s",
       "type": "string",
       "values": [
        "apple",
        "banana",
        "apple pie",
        null
       ]
      },
      {
       "name": "v",
       "type": "number",
       "values": [
        5,
        5.5,
        null,
        7
       ]
      },
      {
       "name": "b",
       "type": "logical",
       "values": [
        true,
        false,
        null,
        true
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "replaceValues",
    "column": "",
    "find": "5",
    "replaceWith": "50",
    "mode": "cell"
   },
   "expect": {
    "columns": [
     {
      "name": "s",
      "type": "string",
      "values": [
       "apple",
       "banana",
       "apple pie",
       null
      ]
     },
     {
      "name": "v",
      "type": "number",
      "values": [
       50,
       5.5,
       null,
       7
      ]
     },
     {
      "name": "b",
      "type": "logical",
      "values": [
       true,
       false,
       null,
       true
      ]
     }
    ]
   }
  },

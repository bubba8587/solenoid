{
 "verb": "rename",
 "cases": [
  {
   "name": "renames by map, order preserved",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2
       ]
      },
      {
       "name": "b",
       "type": "string",
       "values": [
        "x",
        "y"
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "rename",
    "map": {
     "a": "z"
    }
   },
   "expect": {
    "columns": [
     {
      "name": "z",
      "type": "number",
      "values": [
       1,
       2
      ]
     },
     {
      "name": "b",
      "type": "string",
      "values": [
       "x",
       "y"
      ]
     }
    ]
   }
  },
  {
   "name": "an unknown key is a no-op",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "rename",
    "map": {
     "nope": "z"
    }
   },
   "expect": {
    "columns": [
     {
      "name": "a",
      "type": "number",
      "values": [
       1
      ]
     }
    ]
   }
  },
  {
   "name": "a collision uniquifies the displaced column (b -> b2)",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2
       ]
      },
      {
       "name": "b",
       "type": "string",
       "values": [
        "x",
        "y"
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "rename",
    "map": {
     "a": "b"
    }
   },
   "expect": {
    "columns": [
     {
      "name": "b",
      "type": "number",
      "values": [
       1,
       2
      ]
     },
     {
      "name": "b2",
      "type": "string",
      "values": [
       "x",
       "y"
      ]
     }
    ]
   }
  },
  {
   "name": "a renamed column keeps its unit and format",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "k",
       "type": "string",
       "values": [
        "b",
        "a",
        "b"
       ],
       "format": {
        "format": "decimal",
        "unit": "none",
        "decimalDigits": 2,
        "decimalMode": "places"
       }
      },
      {
       "name": "d",
       "type": "number",
       "values": [
        3,
        1,
        2
       ],
       "unit": {
        "dim": {
         "length": 1
        },
        "display": "km"
       },
       "format": {
        "format": "decimal",
        "unit": "none",
        "decimalDigits": 1,
        "decimalMode": "places"
       }
      },
      {
       "name": "w",
       "type": "number",
       "values": [
        30,
        10,
        null
       ],
       "unit": {
        "dim": {
         "mass": 1
        },
        "display": "kg"
       }
      },
      {
       "name": "n",
       "type": "number",
       "values": [
        7,
        8,
        9
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "rename",
    "map": {
     "d": "dist"
    }
   },
   "expect": {
    "columns": [
     {
      "name": "k",
      "type": "string",
      "values": [
       "b",
       "a",
       "b"
      ],
      "format": {
       "format": "decimal",
       "unit": "none",
       "decimalDigits": 2,
       "decimalMode": "places"
      }
     },
     {
      "name": "dist",
      "type": "number",
      "values": [
       3,
       1,
       2
      ],
      "unit": {
       "dim": {
        "length": 1
       },
       "display": "km"
      },
      "format": {
       "format": "decimal",
       "unit": "none",
       "decimalDigits": 1,
       "decimalMode": "places"
      }
     },
     {
      "name": "w",
      "type": "number",
      "values": [
       30,
       10,
       null
      ],
      "unit": {
       "dim": {
        "mass": 1
       },
       "display": "kg"
      }
     },
     {
      "name": "n",
      "type": "number",
      "values": [
       7,
       8,
       9
      ]
     }
    ]
   }
  }
 ]
}

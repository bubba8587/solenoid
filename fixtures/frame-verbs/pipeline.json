{
 "verb": "pipeline",
 "cases": [
  {
   "name": "the report chain: filter, group, sort",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "city",
       "type": "string",
       "values": [
        "Oslo",
        "Bergen",
        "Oslo",
        "Oslo",
        "Bergen",
        "Tromsø"
       ]
      },
      {
       "name": "qty",
       "type": "number",
       "values": [
        10,
        4,
        6,
        2,
        8,
        12
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "filter",
      "column": "qty",
      "op": "gt",
      "value": 5
     },
     {
      "kind": "groupBy",
      "keys": [
       "city"
      ],
      "aggs": [
       {
        "column": "qty",
        "op": "sum",
        "as": "total"
       }
      ]
     },
     {
      "kind": "sort",
      "by": "total",
      "dir": "desc"
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "city",
      "type": "string",
      "values": [
       "Oslo",
       "Tromsø",
       "Bergen"
      ]
     },
     {
      "name": "total",
      "type": "number",
      "values": [
       16,
       12,
       8
      ]
     }
    ]
   }
  },
  {
   "name": "rename mid-chain, later ops see the new name",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2,
        3
       ]
      },
      {
       "name": "b",
       "type": "number",
       "values": [
        4,
        5,
        6
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "rename",
      "map": {
       "a": "x"
      }
     },
     {
      "kind": "select",
      "columns": [
       "x"
      ]
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "x",
      "type": "number",
      "values": [
       1,
       2,
       3
      ]
     }
    ]
   }
  },
  {
   "name": "distinct then head slices the deduped order",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "k",
       "type": "number",
       "values": [
        3,
        1,
        3,
        2,
        1,
        2,
        3
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "distinct"
     },
     {
      "kind": "head",
      "n": 2
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "k",
      "type": "number",
      "values": [
       3,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "drop of the sort key after the sort (projection must not starve it)",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "k",
       "type": "number",
       "values": [
        5,
        1,
        4
       ]
      },
      {
       "name": "v",
       "type": "string",
       "values": [
        "e",
        "a",
        "d"
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "sort",
      "by": "k",
      "dir": "desc"
     },
     {
      "kind": "drop",
      "columns": [
       "k"
      ]
     },
     {
      "kind": "head",
      "n": 2
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "v",
      "type": "string",
      "values": [
       "e",
       "d"
      ]
     }
    ]
   }
  },
  {
   "name": "filter after a group-by runs on the aggregated frame",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "city",
       "type": "string",
       "values": [
        "Oslo",
        "Bergen",
        "Oslo",
        "Oslo",
        "Bergen",
        "Tromsø"
       ]
      },
      {
       "name": "qty",
       "type": "number",
       "values": [
        10,
        4,
        6,
        2,
        8,
        12
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "groupBy",
      "keys": [
       "city"
      ],
      "aggs": [
       {
        "column": "qty",
        "op": "count",
        "as": "n"
       }
      ]
     },
     {
      "kind": "filter",
      "column": "n",
      "op": "gte",
      "value": 2
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "city",
      "type": "string",
      "values": [
       "Oslo",
       "Bergen"
      ]
     },
     {
      "name": "n",
      "type": "number",
      "values": [
       3,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "unpivot then filter on the emitted variable column",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "id",
       "type": "string",
       "values": [
        "r1",
        "r2"
       ]
      },
      {
       "name": "m1",
       "type": "number",
       "values": [
        1,
        2
       ]
      },
      {
       "name": "m2",
       "type": "number",
       "values": [
        3,
        4
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "unpivot",
      "idColumns": [
       "id"
      ],
      "valueColumns": [
       "m1",
       "m2"
      ],
      "variableName": "var",
      "valueName": "val"
     },
     {
      "kind": "filter",
      "column": "var",
      "op": "eq",
      "value": "m2",
      "matchCase": true
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "id",
      "type": "string",
      "values": [
       "r1",
       "r2"
      ]
     },
     {
      "name": "var",
      "type": "string",
      "values": [
       "m2",
       "m2"
      ]
     },
     {
      "name": "val",
      "type": "number",
      "values": [
       3,
       4
      ]
     }
    ]
   }
  },
  {
   "name": "non-finite cells survive a fused filter + sort (NaN masked, inf ordered)",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "v",
       "type": "number",
       "values": [
        1,
        {
         "__nf": "nan"
        },
        {
         "__nf": "inf"
        },
        -1,
        null,
        0
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "filter",
      "column": "v",
      "op": "gte",
      "value": 0
     },
     {
      "kind": "sort",
      "by": "v",
      "dir": "desc"
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "v",
      "type": "number",
      "values": [
       {
        "__nf": "inf"
       },
       1,
       0
      ]
     }
    ]
   }
  },
  {
   "name": "a single op degenerates to the verb itself",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2,
        3
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "head",
      "n": 2
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "a",
      "type": "number",
      "values": [
       1,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "empty ops is the identity",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2
       ]
      },
      {
       "name": "s",
       "type": "string",
       "values": [
        "x",
        null
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": []
   },
   "expect": {
    "columns": [
     {
      "name": "a",
      "type": "number",
      "values": [
       1,
       2
      ]
     },
     {
      "name": "s",
      "type": "string",
      "values": [
       "x",
       null
      ]
     }
    ]
   }
  },
  {
   "name": "an error mid-chain surfaces that op's code",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "a",
       "type": "number",
       "values": [
        1,
        2,
        3
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "filter",
      "column": "missing",
      "op": "gt",
      "value": 0
     },
     {
      "kind": "select",
      "columns": [
       "a"
      ]
     }
    ]
   },
   "expectError": "#REF!"
  },
  {
   "name": "a sort over the all-null agg of single-row groups keeps group order",
   "frames": {
    "in": {
     "columns": [
      {
       "name": "k",
       "type": "string",
       "values": [
        "x",
        "y",
        "z"
       ]
      },
      {
       "name": "a",
       "type": "number",
       "values": [
        3,
        1,
        2
       ]
      }
     ]
    }
   },
   "op": {
    "kind": "pipeline",
    "ops": [
     {
      "kind": "groupBy",
      "keys": [
       "k"
      ],
      "aggs": [
       {
        "column": "a",
        "op": "stdev",
        "as": "s"
       }
      ]
     },
     {
      "kind": "sort",
      "by": "s",
      "dir": "desc"
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "k",
      "type": "string",
      "values": [
       "x",
       "y",
       "z"
      ]
     },
     {
      "name": "s",
      "type": "number",
      "values": [
       null,
       null,
       null
      ]
     }
    ]
   }
  }
 ]
}

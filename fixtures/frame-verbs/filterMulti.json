    }
   },
   "op": {
    "kind": "filterMulti",
    "combine": "and",
    "conditions": [
     {
      "column": "v",
      "op": "gt",
      "value": 2
     },
     {
      "column": "s",
      "op": "eq",
      "value": "b"
     }
    ]
   },
   "expect": {
    "columns": [
     {
      "name": "v",
      "type": "number",
      "values": [
       5,
       8

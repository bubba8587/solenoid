{
  "label": "Solar payback",
  "nodes": [
    {
      "id": "out",
      "type": "FrameInputNode",
      "init": {
        "label": "Monthly output"
      },
      "frame": [
        {
          "name": "Month",
          "cells": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ]
        },
        {
          "name": "kWh",
          "cells": [
            390,
            450,
            620,
            710,
            800,
            850,
            870,
            820,
            700,
            560,
            420,
            370
          ]
        }
      ],
      "x": 0,
      "y": 0
    },
    {
      "id": "kwh",
      "type": "GetColumnNode",
      "init": {
        "label": "kWh",
        "readAs": "number"
      },
      "stringLiterals": {
        "name": "kWh"
      },
      "x": 0,
      "y": 265
    },
    {
      "id": "chart",
      "type": "ChartNode",
      "init": {
        "label": "Output by month",
        "op": "column"
      },
      "stringLiterals": {
        "options": "title=kWh per month"
      },
      "x": 398,
      "y": 74
    },
    {
      "id": "savings",
      "type": "ExpressionNode",
      "init": {
        "label": "Monthly savings",
        "expr": "ROUND(AVERAGE(kwh) * rate, 0)"
      },
      "x": 720,
      "y": 0
    },
    {
      "id": "payback",
      "type": "ExpressionNode",
      "init": {
        "label": "Payback years",
        "expr": "ROUND(cost / savings / 12, 1)"
      },
      "x": 720,
      "y": 262
    },
    {
      "id": "even",
      "type": "ExpressionNode",
      "init": {
        "label": "Breaks even on",
        "expr": "EDATE(installed, ROUND(years * 12, 0))",
        "resultAs": "date"
      },
      "x": 720,
      "y": 548
    },
    {
      "id": "net",
      "type": "ExpressionNode",
      "init": {
        "label": "Net by year",
        "expr": "SEQUENCE(25) * savings * 12 - cost"
      },
      "x": 1022,
      "y": 0
    },
    {
      "id": "spark",
      "type": "ChartNode",
      "init": {
        "label": "25 years",
        "op": "line"
      },
      "stringLiterals": {
        "options": "title=Net savings"
      },
      "x": 1022,
      "y": 250
    },
    {
      "id": "verdict",
      "type": "AlertNode",
      "x": 1022,
      "y": 572,
      "init": {
        "label": "Inside the warranty?"
      },
      "literals": {
        "value": 0,
        "low": 0,
        "high": 25,
        "target": 0
      }
    },
    {
      "id": "rate",
      "type": "ValueInputNode",
      "init": {
        "label": "Rate per kWh",
        "op": "number",
        "value": "0.17",
        "format": "decimal",
        "decimalDigits": 2,
        "unit": "usd"
      },
      "x": 0,
      "y": 614,
      "sections": {
        "Format": false
      }
    },
    {
      "id": "cost",
      "type": "ValueInputNode",
      "init": {
        "label": "Install cost",
        "op": "number",
        "value": "14500",
        "format": "decimal",
        "decimalDigits": 0,
        "unit": "usd"
      },
      "x": 214,
      "y": 614,
      "sections": {
        "Format": false
      }
    },
    {
      "id": "installed",
      "type": "ValueInputNode",
      "init": {
        "label": "Installed",
        "op": "date",
        "value": "15-Apr-2026"
      },
      "x": 428,
      "y": 614
    },
    {
      "id": "g_prod",
      "type": "GroupNode",
      "x": -20,
      "y": -50,
      "init": {
        "label": "Production",
        "members": [
          "out",
          "kwh",
          "chart"
        ],
        "color": "sky",
        "collapsed": false,
        "width": 600,
        "height": 520
      }
    },
    {
      "id": "g_in",
      "type": "GroupNode",
      "x": -20,
      "y": 564,
      "init": {
        "label": "Inputs",
        "members": [
          "rate",
          "cost",
          "installed"
        ],
        "color": "gold",
        "collapsed": false,
        "width": 440,
        "height": 360
      }
    },
    {
      "id": "g_pay",
      "type": "GroupNode",
      "x": 700,
      "y": -50,
      "init": {
        "label": "Payback",
        "members": [
          "savings",
          "payback",
          "even",
          "net",
          "spark",
          "verdict"
        ],
        "color": "green",
        "collapsed": false,
        "width": 600,
        "height": 840
      }
    }
  ],
  "cables": [
    "out.frame -> chart.values",
    "out.frame -> kwh.frame",
    "kwh.values -> savings.kwh",
    "rate.value -> savings.rate",
    "cost.value -> payback.cost",
    "savings.result -> payback.savings",
    "installed.value -> even.installed",
    "payback.result -> even.years",
    "savings.result -> net.savings",
    "cost.value -> net.cost",
    "net.result -> spark.values",
    "payback.result -> verdict.value"
  ]
}
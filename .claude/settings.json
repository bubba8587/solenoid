{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx tsx scripts/parity.ts)",
      "Bash(python3 tools/dte.py *)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/leaf-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

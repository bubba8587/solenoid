  "nodes": [
    {
      "id": "note",
      "type": "NoteNode",
      "x": -40,
      "y": -232,
      "init": {
        "label": "Trip split",
        "body": "# Who pays whom\nOne trip, uneven receipts. **Group Cost Settle** nets everyone against their fair share and pays it back in the fewest transfers, exact to the cent.\n\nThe **Input Switch** picks which description of the same trip feeds it. Flip it, and the Settle **mode** to match:\n\n- **Ledger, in Transactions mode:** a cube of expenses. Each row is an Amount, who **Paid** (one name or a shared bill), and who it is **For** (split equally; blank means everyone). Ada frontloads the hotel with Bo and covers Cy's ticket alone.\n- **Receipts, in Totals mode:** one row per person with what each **Paid** and an optional **Share** weight.",
        "color": "violet",
        "width": 400,
        "height": 250
      }
    },
    {
      "id": "ledger",
      "type": "CubeInputNode",
      "x": -40,
      "y": 92,
      "init": {
        "label": "Expenses (ledger)",
        "cubeText": "[\n  {\"Item\": \"Dinner\",      \"Amount\": 120, \"Paid by\": \"Ada\",          \"For\": [\"Ada\", \"Bo\", \"Cy\", \"Di\"]},\n  {\"Item\": \"Taxi\",        \"Amount\": 40,  \"Paid by\": \"Bo\",           \"For\": [\"Bo\", \"Cy\"]},\n  {\"Item\": \"Hotel\",       \"Amount\": 300, \"Paid by\": [\"Ada\", \"Bo\"],  \"For\": [\"Ada\", \"Bo\", \"Cy\", \"Di\"]},\n  {\"Item\": \"Cy's ticket\", \"Amount\": 60,  \"Paid by\": \"Ada\",          \"For\": [\"Cy\"]}\n]"
      }
    },
    {
      "id": "receipts",

    },
    {
      "id": "note-invert",
      "type": "NoteNode",
      "x": 1120,
      "y": 940,
      "init": {
        "label": "Functions invert too",
        "body": "The solver peels the algebra step by step — here it squares away the SQRT, then subtracts a². EXP/LN, LOG, trig and % invert the same way. Roots take the principal branch: b = 12, not −12.",
        "width": 400,
        "height": 140
      }
    },
    {
      "id": "n-pv",

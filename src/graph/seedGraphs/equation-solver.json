      "init": {
        "label": "The rule of 72, exactly",
        "body": "\"What growth rate doubles my money in 10 years?\" is a solve-for-the-exponent-base question — Excel needs RATE() or Goal Seek for this. The answer, ≈ 0.0718, is where the rule of 72 comes from.",
        "width": 400,
        "height": 140
      }
    },

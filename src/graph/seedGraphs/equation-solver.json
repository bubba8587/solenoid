      "x": 1120,
      "y": 1920,
      "init": {
        "label": "When algebra can't",
        "body": "x appears twice, so no rearrangement isolates it. The node switches to root-finding on LHS − RHS and returns x = 2. If no real root exists, it says so with **#SOLVE!**.",
        "width": 400,
        "height": 130
      }
    },

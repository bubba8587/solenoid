    },
    {
      "id": "eq-pyth",
      "type": "EquationNode",
      "x": 360,
      "y": 880,
      "init": {
        "label": "Pythagoras, backwards",
        "expr": "c = SQRT(a^2 + b^2)"
      }
    },
    {
      "id": "disp-legb",
      "type": "DisplayNode",
      "x": 780,
      "y": 970,
      "init": {
        "label": "Leg b"

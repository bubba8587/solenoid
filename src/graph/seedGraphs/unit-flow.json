{
  "v": 1,
  "label": "Unit Flow",
  "nodes": [
    {
      "id": "hdr",
      "type": "NoteNode",
      "x": -380,
      "y": -220,
      "init": {
        "label": "Unit Flow — how a Format Controller locks a value",
        "body": "A **Format Controller (FC)** locks a value's **unit** and **number format** ($, km, 2 decimals…). The lock belongs to the *value*, so it travels through every node that just **passes the value along** (a Display) — up AND down the stream — and **breaks** at any node that **transforms** it. Each lane shows one rule; watch the value boxes.",
        "color": "gray",
        "width": 900,
        "height": 190
      }
    },
    {
      "id": "capA",
      "type": "NoteNode",
      "x": -380,
      "y": 40,
      "init": {
        "label": "A · Lock once → carries DOWNSTREAM",
        "body": "The FC locks `$` + 2dp on Revenue. Every Display *after* it shows `$1,234.50` with **no trailing FC** of its own — the lock rides the value forward through passthroughs.",
        "color": "blue",
        "width": 330,
        "height": 170
      }
    },
    {
      "id": "A_num",
      "type": "NumberInputNode",
      "x": 40,
      "y": 63,
      "init": {
        "label": "Revenue",
        "value": 1234.5
      }
    },
    {
      "id": "A_fc",
      "type": "FormatControllerNode",
      "x": 250,
      "y": 81,
      "init": {
        "label": "Format",
        "hostNodeId": "A_num",
        "socketKey": "value",
        "side": "output",
        "format": "decimal",
        "decimalDigits": 2,
        "decimalMode": "places",
        "unit": "usd",
        "socketDataType": "number"
      }
    },
    {
      "id": "A_d1",
      "type": "DisplayNode",

      "y": 560,
      "init": {
        "label": "C · A transform BREAKS it",
        "body": "`$10.00` each. Multiplying by 100 makes a **new value**, so the `$` doesn't carry — the lot total shows a bare `1,000`. Breaking at a transform is the default for anything that isn't a passthrough.",
        "color": "amber",
        "width": 330,
        "height": 170
      }
    },

  "nodes": [
    {
      "id": "hdr",
      "type": "NoteNode",
      "x": -380,
      "y": 2512,
      "init": {
        "label": "Unit Flow: units live on the value; format is display",
        "body": "A value's **unit** is part of the VALUE: a **Format Controller (FC)** authors it, **Convert** re-expresses it, and it **computes** — `5 m ÷ 1 s` IS `5 m/s`, `$ + 2` adopts the `$`, meters + seconds is a **#UNIT!**. The number **format** ($ places, 2 decimals) stays a display lock that rides passthroughs and drops at a transform. Lanes go simple → complex; watch the value boxes and the FC arrows.",
        "color": "gray",
        "width": 900,
        "height": 190
      }
    },
    {
      "id": "capA",
      "type": "NoteNode",
      "x": -87,
      "y": -351,
      "init": {
        "label": "A · Lock once → carries DOWNSTREAM",
        "body": "The FC locks `$` + 2dp on Revenue. Every Display *after* it shows `$1,234.50` with **no trailing FC** of its own; the lock rides the value forward through passthroughs.",
        "color": "blue",
        "width": 330,
        "height": 170
      }
    },

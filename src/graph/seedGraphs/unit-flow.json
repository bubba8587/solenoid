    {
      "id": "capB",
      "type": "NoteNode",
      "x": -380,
      "y": 300,
      "init": {
        "label": "B · Reaches UPSTREAM too",
        "body": "The FC sits at the **end**. Both Displays in *front* of it — even two hops up — still show `1,200 km`. (The raw input box stays unformatted: the lock lives in the passthrough run, between the value's origin and the FC.)",
        "color": "green",
        "width": 330,
        "height": 180
      }
    },

        "frameText": "[{\"name\":\"Person\",\"type\":\"string\",\"values\":[\"Ada\",\"Bo\",\"Cy\",\"Di\",\"Eli\"]},{\"name\":\"Min\",\"type\":\"number\",\"unit\":\"hr\",\"values\":[16,20,8,24,12]},{\"name\":\"Max\",\"type\":\"number\",\"unit\":\"hr\",\"values\":[40,32,24,40,20]},{\"name\":\"Weight\",\"type\":\"number\",\"values\":[2,1,1,3,1]}]"

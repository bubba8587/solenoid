    {
      "id": "hdr",
      "type": "NoteNode",
      "x": -26,
      "y": 4974,
      "init": {
        "label": "Null & Logical: the value model",
        "body": "This canvas tours the value model: a first-class **null**, a real **logical** type, and **per-cell errors** that stay in a list. Null means missing; it renders as `null` and aggregators skip it. Logicals are TRUE/FALSE on purple sockets and coerce to 1/0 in math. Each cluster shows one decision.",
        "color": "blue",
        "width": 760,
        "height": 190
      }
    },
    {
      "id": "nA",
      "type": "NoteNode",
      "x": 808,
      "y": 5210,
      "init": {
        "label": "A · Aggregators skip null",
        "body": "The `vals` column has a **blank cell** in row 2, which imports as **null**. SUM = 8; AVERAGE = 8/3, dividing by the 3 PRESENT values, not 4. The list shows `1, null, 3, 4`.",
        "color": "green",
        "width": 230,
        "height": 230
      }
    },

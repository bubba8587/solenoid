{
  "v": 2,
  "label": "Null & Logical",
  "nodes": [
    {
      "id": "hdr",
      "type": "NoteNode",
      "x": -40,
      "y": -200,
      "init": {
        "label": "Null & Logical \u2014 array-semantics tour",
        "body": "A living checklist for the value model: a first-class **null** (missing, rendered `null`, skipped by aggregators), a real **logical** type (TRUE/FALSE, purple sockets, coerces to 1/0 in math), and **per-cell errors** that stay in a list. Each cluster shows one decision.",
        "color": "blue",
        "width": 760,
        "height": 190
      }
    },
    {
      "id": "nA",
      "type": "NoteNode",
      "x": -40,
      "y": 40,
      "init": {
        "label": "A \u00b7 Aggregators skip null",
        "body": "The `vals` column has a **blank cell** (row 2) \u2192 imports as **null**. SUM = 8; AVERAGE = 8/3 (divides by the 3 PRESENT values, not 4). The list shows `1, null, 3, 4`.",
        "color": "green",
        "width": 230,
        "height": 230
      }
    },
    {
      "id": "fiA",
      "type": "FrameInputNode",
      "x": 230,
      "y": 60,
      "init": {
        "label": "CSV (blank cell in vals)",
        "frameText": "vals, tag\n1, a\n, b\n3, c\n4, d"
      }
    },

    {
      "id": "share",
      "type": "ArithmeticNode",
      "x": 860,
      "y": -130,
      "init": {
        "label": "Fair share",
        "op": "div"
      }
    },
    {
      "id": "letter",
      "type": "NoteNode",
      "x": -40,
      "y": 120,
      "init": {
        "label": "Letter template",
        "body": "---\nsubject: Trip settle-up\ntreasurer: Ada\n---\n# {{ subject }}: {{ record.Name }}\n\nHi {{ record.Name }},\n\nThe trip cost **{{ total }}** between {{ records | length }} of us, so a fair share is **{{ share | number_format:2 }}**. You paid **{{ record.Paid }}**.\n\n{% if record.Paid > share %}You paid more than your share; {{ treasurer }} will send the difference back.\n{% elseif record.Paid < share %}Please send **{{ share | number_format:2 }}** less what you paid to {{ treasurer }}.\n{% else %}You are exactly square.\n{% endif %}\nPaid so far, most first: {{ records | sort:(\"Paid\",\"desc\") | map:x => x.Name | join:\", \" }}. {% set stragglers = records | where:(\"Paid\", 0) | map:x => x.Name | join:\", \" %}{% if stragglers %}Still to chip in: {{ stragglers }}.{% endif %}\n\nReply to {{ record.Email }} if a number looks off.\n\n*Letter {{ index }} of {{ records | length }}, generated from the ledger.*\n",
        "color": "slate",
        "width": 520,
        "height": 330
      }
    },
    {
      "id": "report",
      "type": "ReportNode",
      "x": 860,
      "y": 140,
      "init": {
        "label": "Settle-up letters",
        "body": "",
        "color": "sky",
        "width": 260,
        "height": 120,
        "sideVars": [
          "subject",
          "total",
          "share",
          "treasurer"
        ],
        "pageName": "Settle-up {{ record.Name }}"
      }
    },

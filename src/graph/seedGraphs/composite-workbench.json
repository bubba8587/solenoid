    {
      "id": "note1",
      "type": "NoteNode",
      "x": -40,
      "y": 260,
      "init": {
        "label": "Simulation = a wired feedback loop",
        "body": "# Simulation mode\nThis container holds a REAL cable cycle (add deposit → grow 5% → back into add). In **Simulation** mode the loop runs as bounded feedback — one entry per step. Every other mode dead-ends the same loop as **#CIRC!**. Drill in to see (and rewire) the loop.",
        "color": "amber",
        "width": 430,
        "height": 180
      }
    },
    {
      "id": "deposit",
      "type": "NumberInputNode",
      "x": -40,
      "y": 468,
      "init": {
        "label": "Deposit / step",
        "value": 100
      }
    },

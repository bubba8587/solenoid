        "frameText": "[{\"name\":\"Task\",\"type\":\"string\",\"values\":[\"Write the spec\",\"Fix the login bug\",\"Renew the domain\",\"Plan the offsite\",\"Reply to the auditor\",\"Update the deck\",\"Migrate the database\",\"Book flights\",\"Review pull requests\",\"Draft the newsletter\",\"Clean the inbox\",\"Order the parts\"]},{\"name\":\"Priority\",\"type\":\"number\",\"values\":[3,3,2,1,3,2,3,2,2,1,1,2]},{\"name\":\"Days to due\",\"type\":\"number\",\"values\":[5,1,2,20,0,7,14,3,1,9,30,4]},{\"name\":\"Estimate h\",\"type\":\"number\",\"values\":[4,2,0.5,3,1,2,16,1,2,3,1,0.5]},{\"name\":\"Blocked\",\"type\":\"logical\",\"values\":[false,false,false,true,false,false,true,false,false,false,false,true]}]"

      }
    },
    {
      "id": "mask",
      "type": "MakeArrayNode",
      "x": 3112,
      "y": 1034,
      "init": {
        "label": "Causal mask: no looking ahead"
      },
      "stringLiterals": {
        "formula": "IF(col <= row, 0, -1E9)"
      }
    },
    {
      "id": "scores",
      "type": "ExpressionNode",
      "x": 3470,
      "y": 712,
      "init": {
        "label": "Scores",
        "expr": "MMULT(Q, TRANSPOSE(K)) / SQRT(4) + mask"
      }

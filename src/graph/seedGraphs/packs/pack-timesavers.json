      "id": "pct",
      "x": 0,
      "y": 220,
      "type": "ExpressionNode",
      "init": {
        "label": "Percent Change",
        "expr": "(after-before)/before",
        "locked": true,
        "castTo": "none",
        "width": 220,
        "height": 210
      },
      "literals": {
        "before": 80,
        "after": 92
      }
    },

      "y": 200,
      "type": "ExpressionNode",
      "init": {
        "label": "Great-Circle Distance",
        "expr": "2*6371.0088*ASIN(SQRT(SIN((lat2-lat1)*PI()/360)^2+COS(lat1*PI()/180)*COS(lat2*PI()/180)*SIN((lon2-lon1)*PI()/360)^2))",
        "locked": true,
        "castTo": "none",
        "width": 220,
        "height": 210
      },
      "literals": {
        "lat1": 51.5074,
        "lon1": -0.1278,
        "lat2": 40.7128,
        "lon2": -74.006
      }
    },

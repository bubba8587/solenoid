  "label": "Earth & Sky: distance, sun and moon",
  "group": "Packs",
  "nodes": [
    {
      "id": "head",
      "x": 0,
      "y": 0,
      "type": "NoteNode",
      "init": {
        "label": "Earth & Sky",
        "color": "amber",
        "collapsed": false,
        "width": 760,
        "height": 150,
        "body": "London to New York along the Earth's surface (the **great-circle** distance) and the compass bearing to set out on. For midsummer's day in London: where the **sun** stands, when it **rises and sets**, and the **moon's** phase.",
        "fieldTypes": {}
      }
    },
    {
      "id": "gc",
      "x": 0,
      "y": 200,
      "type": "ExpressionNode",
      "init": {
        "label": "Great-Circle Distance",
        "expr": "2*6371.0088\n* ASIN(\n    SQRT(\n      SIN((lat2-lat1)*PI()/360)^2\n      + COS(lat1*PI()/180)\n        * COS(lat2*PI()/180)\n        * SIN((lon2-lon1)*PI()/360)^2\n    )\n  )",
        "locked": true,
        "castTo": "none",
        "width": 220,
        "height": 210,
        "varDescriptions": {
          "lat1": "Start latitude (°)",
          "lon1": "Start longitude (°)",
          "lat2": "End latitude (°)",
          "lon2": "End longitude (°)"
        }
      },
      "literals": {
        "lat1": 51.5074,
        "lon1": -0.1278,
        "lat2": 40.7128,
        "lon2": -74.006
      }
    },
    {
      "id": "brg",
      "x": 440,
      "y": 200,
      "type": "ExpressionNode",
      "init": {
        "label": "Initial Bearing",
        "expr": "MOD(\n  DEGREES(\n      ATAN2(\n        COS(lat1*PI()/180)\n          * SIN(lat2*PI()/180)\n        - SIN(lat1*PI()/180)\n          * COS(lat2*PI()/180)\n          * COS((lon2-lon1)*PI()/180),\n        SIN((lon2-lon1)*PI()/180)\n        * COS(lat2*PI()/180)\n      )\n    )\n  + 360,\n  360\n)",
        "locked": true,
        "castTo": "none",
        "width": 220,
        "height": 210,
        "varDescriptions": {
          "lat1": "Start latitude (°)",
          "lon1": "Start longitude (°)",
          "lat2": "End latitude (°)",
          "lon2": "End longitude (°)"
        }
      },
      "literals": {
        "lat1": 51.5074,
        "lon1": -0.1278,
        "lat2": 40.7128,
        "lon2": -74.006
      }
    },

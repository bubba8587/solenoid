{
  "label": "Power Features",
  "v": 2,
  "nodes": [
    {
      "id": "n-start",
      "type": "NoteNode",
      "x": 140,
      "y": -680,
      "init": {
        "label": "Start here",
        "body": "# Power features tour\nEach cluster shows a feature that is easy to miss. Drag the sliders, click the Conduit, and right-click pairs of nodes and selected cables. **Ctrl+/** opens the full Reference.",
        "color": "blue",
        "width": 430,
        "height": 160,
        "collapsed": false
      }
    },
    {
      "id": "note-lambda",
      "type": "NoteNode",
      "x": -360,
      "y": -400,
      "init": {
        "label": "Lambdas",
        "body": "# λ as a value\nThe **LAMBDA** node packages a formula. `rate` isn't a parameter, so it became a wired input whose live value is baked into the λ; Excel would write LET. Wire the λ into MAP or REDUCE and it replaces their inline formula; parameters bind by position. Drag the Rate slider and everything downstream follows.",
        "color": "green",
        "width": 360,
        "height": 250,
        "collapsed": false
      }
    },
    {
      "id": "slider-rate",
      "type": "SliderInputNode",
      "x": -347,
      "y": -93,
      "init": {
        "label": "Rate",
        "value": 3,
        "min": 0,
        "max": 10,
        "step": 0.5
      },
      "literals": {
        "min": 0,
        "max": 10,
        "step": 0.5
      }
    },
    {
      "id": "lambda-1",
      "type": "LambdaNode",
      "x": -60,
      "y": -120,
      "init": {
        "label": "× rate",
        "params": "x",
        "expr": "x * rate"
      },
      "literals": {
        "rate": 3
      }
    },
    {
      "id": "range-1",
      "type": "RangeNode",
      "x": -337,
      "y": 190,
      "init": {
        "label": "1 to 6"
      },
      "literals": {
        "start": 1,
        "stop": 7,
        "step": 1
      }
    },
    {
      "id": "map-1",
      "type": "MapTableNode",
      "x": 220,
      "y": -60,
      "init": {
        "label": "MAP through λ"
      },
      "literals": {},
      "stringLiterals": {
        "formula": "value^2"
      }
    },
    {
      "id": "disp-map",
      "type": "DisplayNode",
      "x": 520,

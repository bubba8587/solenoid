        "collapsed": false
      }
    },
    {
      "id": "note-units",
      "type": "NoteNode",
      "x": -317,
      "y": -315,
      "init": {
        "label": "Units",
        "body": "# Units travel with the value\n**Convert** turns miles into kilometers, and from there the *value itself* carries km. The Display and its docked **Format** controller pick the unit up and lock to it: you can re-format the number but never mislabel the unit. Convert is the authority in any chain of formats.",
        "color": "vermilion",
        "width": 360,
        "height": 240,
        "collapsed": false
      }

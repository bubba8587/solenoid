  "nodes": [
    {
      "id": "noteIntro",
      "type": "NoteNode",
      "x": 79,
      "y": 186,
      "init": {
        "label": "Write it back to Obsidian",
        "body": "# Compute here, see it in Obsidian\nRead your project notes, add a **health** label from status and priority, and write it back as a property. In Obsidian a Bases view over the folder then shows the new column live.\n\nThe **Projects** table here is a snapshot so it runs on the web. On desktop, swap in the **Vault Folder** below and point it at your vault. **Write Properties** loads disarmed and previews every change, so nothing is written until you press its Run button.",
        "color": "violet",
        "width": 380,
        "height": 260
      }
    },
    {
      "id": "projects",
      "type": "FrameInputNode",
      "x": -16,
      "y": 607,
      "init": {
        "label": "Projects (snapshot)",
        "frameText": "[{\"name\":\"path\",\"type\":\"string\",\"values\":[\"Projects/Kitchen remodel.md\",\"Projects/Garden overhaul.md\",\"Projects/Website launch.md\",\"Projects/Home office setup.md\",\"Projects/Basement waterproofing.md\",\"Projects/Client onboarding revamp.md\"]},{\"name\":\"name\",\"type\":\"string\",\"values\":[\"Kitchen remodel\",\"Garden overhaul\",\"Website launch\",\"Home office setup\",\"Basement waterproofing\",\"Client onboarding revamp\"]},{\"name\":\"status\",\"type\":\"string\",\"values\":[\"active\",\"blocked\",\"planning\",\"done\",\"planning\",\"active\"]},{\"name\":\"priority\",\"type\":\"number\",\"values\":[5,2,3,3,2,4]},{\"name\":\"budget\",\"type\":\"number\",\"values\":[18500,1200,6000,2400,5400,9000]}]"
      }
    },
    {
      "id": "health",
      "type": "ComputedColumnNode",
      "x": 309,
      "y": 542,
      "init": {
        "label": "health from status + priority",
        "expr": "IF(@status=\"done\",\"done\",IF(@status=\"blocked\",\"at risk\",IF(@priority>=4,\"push\",\"steady\")))",
        "addAs": "text"
      },
      "stringLiterals": {
        "name": "health",
        "after": ""
      }
    },
    {

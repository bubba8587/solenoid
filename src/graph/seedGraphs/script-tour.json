    {
      "id": "sc-cube",
      "type": "ScriptNode",
      "x": 304,
      "y": 844,
      "init": {
        "label": "Nested rows: a cube",
        "expr": "(growth) => [\"North\", \"South\"]\n  .map((region, i) => ({\n    region,\n    quarters: [1, 2, 3, 4].map((q) => ({\n      quarter: q,\n      sales: Math.round(\n        100 * (i + 1) * growth ** q,\n      ),\n    })),\n  }))"
      }
    },

    {
      "id": "in-principal",
      "type": "NumberInputNode",
      "x": 0,
      "y": 1000,
      "init": {
        "label": "Principal",
        "value": 250000
      }
    },
    {
      "id": "sc-loan",
      "type": "ScriptNode",
      "x": 320,
      "y": 880,
      "init": {
        "label": "Amortization table",
        "expr": "(principal, rate, years) => {\n  const r = rate / 100 / 12;\n  const n = years * 12;\n  const pow = (1 + r) ** -n;\n  const pay = principal * r / (1 - pow);\n  const rows = [\n    [\"year\", \"interest\", \"balance\"],\n  ];\n  let bal = principal;\n  let paid = 0;\n  for (let m = 1; m <= n; m++) {\n    const i = bal * r;\n    paid += i;\n    bal -= pay - i;\n    if (m % 60 === 0) rows.push([\n      m / 12,\n      Math.round(paid),\n      Math.round(bal),\n    ]);\n  }\n  return rows;\n}",
        "resultAs": "auto"
      },
      "literals": {
        "rate": 4.5,
        "years": 30
      }
    },
    {
      "id": "d-loan",
      "type": "DisplayNode",
      "x": 700,
      "y": 1000,
      "init": {
        "label": "Every 5 years"
      }
    },

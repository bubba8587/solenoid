    {
      "id": "note-head",
      "type": "NoteNode",
      "x": 0,
      "y": -360,
      "init": {
        "label": "Script: worked examples",
        "color": "amber",
        "body": "One JavaScript function per node: parameters are the inputs, the return value is the result. A script can return a single value, a list, or rows of values, and numbers, text, booleans and dates travel as plain JS values. The examples below return a number, a list, a text summary, a table, and dates.",
        "width": 560
      }
    },
    {
      "id": "in-samples",
      "type": "NumberInputNode",
      "x": 0,
      "y": 60,
      "init": {
        "label": "Samples",
        "value": 100000
      }
    },
    {
      "id": "sc-pi",
      "type": "ScriptNode",
      "x": 320,
      "y": 0,
      "init": {
        "label": "Monte Carlo π",
        "expr": "(samples, seed) => {\n  let s = seed >>> 0;\n  const rand = () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 2 ** 32;\n  };\n  let hits = 0;\n  for (let i = 0; i < samples; i++) {\n    const x = rand();\n    const y = rand();\n    if (x * x + y * y <= 1) hits++;\n  }\n  return 4 * hits / samples;\n}",
        "resultAs": "number"
      },
      "literals": {
        "seed": 1
      }
    },
    {
      "id": "d-pi",
      "type": "DisplayNode",
      "x": 700,
      "y": 130,
      "init": {
        "label": "→ 3.1437"
      }
    },
    {
      "id": "in-n",
      "type": "NumberInputNode",
      "x": 0,
      "y": 560,
      "init": {
        "label": "27",
        "value": 27
      }
    },
    {
      "id": "sc-collatz",
      "type": "ScriptNode",
      "x": 320,
      "y": 480,
      "init": {
        "label": "Collatz path",
        "expr": "(n) => {\n  const path = [n];\n  while (n > 1 && path.length < 1000) {\n    n = n % 2 ? 3 * n + 1 : n / 2;\n    path.push(n);\n  }\n  return path;\n}",
        "resultAs": "number"
      }
    },
    {
      "id": "spark",
      "type": "SparklineNode",
      "x": 700,
      "y": 480,
      "init": {
        "label": "Sparkline"
      }
    },
    {
      "id": "sc-summary",
      "type": "ScriptNode",
      "x": 1020,
      "y": 480,
      "init": {
        "label": "Path summary",
        "expr": "(path) => {\n  const steps = path.length - 1;\n  const peak = Math.max(...path);\n  return steps + \" steps, peak \" + peak;\n}",
        "resultAs": "text"
      }
    },
    {
      "id": "d-summary",
      "type": "DisplayNode",
      "x": 1360,
      "y": 560,
      "init": {
        "label": "→ 111 steps, peak 9232"
      }

    {
      "id": "sc-fri13",
      "type": "ScriptNode",
      "x": 320,
      "y": 1540,
      "init": {
        "label": "Friday the 13ths",
        "expr": "(year) => {\n  const hits = [];\n  for (let m = 0; m < 12; m++) {\n    const d = new Date(Date.UTC(year, m, 13));\n    if (d.getUTCDay() === 5) hits.push(d);\n  }\n  return hits;\n}",
        "resultAs": "date"
      }
    },

  "nodes": [
    {
      "id": "note-head",
      "type": "NoteNode",
      "x": -130,
      "y": 1343,
      "init": {
        "label": "Script: worked examples",
        "color": "amber",
        "body": "One JavaScript function per node: parameters are the inputs, the return value is the result, and the value types itself. A script can return a single value, a list, rows of values, or rows of {name: value} objects, which become a frame with typed columns; rows nested inside a row's cell make a cube. A wired frame or cube arrives the same way, as rows. A date input arrives as its Excel serial; return a Date, or Solenoid.date(serial), to make dates. The examples below return a number, a list, a text summary, a frame that a second script reads back, dates, and a cube rolled up by a verb.",
        "width": 560
      }
    },
    {
      "id": "in-samples",
      "type": "NumberInputNode",
      "x": 494,
      "y": 1394,
      "init": {
        "label": "Samples",
        "value": 100000
      }
    },
    {
      "id": "sc-pi",
      "type": "ScriptNode",
      "x": 759,
      "y": 1276,
      "init": {
        "label": "Monte Carlo π",
        "expr": "(samples) => {\n  let hits = 0;\n  for (let i = 0; i < samples; i++) {\n    const x = Math.random();\n    const y = Math.random();\n    if (x * x + y * y <= 1) hits++;\n  }\n  return 4 * hits / samples;\n}"
      }
    },
    {
      "id": "d-pi",
      "type": "DisplayNode",
      "x": 1084,
      "y": 1389,
      "init": {
        "label": "≈ 3.14"
      }
    },
    {
      "id": "in-n",
      "type": "NumberInputNode",
      "x": 13,
      "y": 1854,
      "init": {
        "label": "27",
        "value": 27
      }
    },
    {
      "id": "sc-collatz",
      "type": "ScriptNode",
      "x": 278,
      "y": 1762,
      "init": {
        "label": "Collatz path",
        "expr": "(n) => {\n  const path = [n];\n  while (n > 1 && path.length < 1000) {\n    n = n % 2 ? 3 * n + 1 : n / 2;\n    path.push(n);\n  }\n  return path;\n}"
      }
    },
    {
      "id": "spark",
      "type": "SparklineNode",
      "x": 611,
      "y": 1715,
      "init": {
        "label": "Sparkline"
      }
    },
    {
      "id": "sc-summary",
      "type": "ScriptNode",
      "x": 611,
      "y": 1892,
      "init": {
        "label": "Path summary",
        "expr": "(path) => {\n  const steps = path.length - 1;\n  const peak = Math.max(...path);\n  return steps + \" steps, peak \" + peak;\n}"
      }
    },
    {
      "id": "d-summary",
      "type": "DisplayNode",
      "x": 936,
      "y": 1958,
      "init": {
        "label": "→ 111 steps, peak 9232"
      }
    },
    {
      "id": "in-principal",
      "type": "NumberInputNode",
      "x": 6,
      "y": 23,
      "init": {
        "label": "Principal",
        "value": 250000
      }
    },
    {
      "id": "sc-loan",
      "type": "ScriptNode",
      "x": 271,
      "y": -175,
      "init": {
        "label": "Amortization table",
        "expr": "(principal, rate, years) => {\n  const r = rate / 100 / 12;\n  const n = years * 12;\n  const pow = (1 + r) ** -n;\n  const pay = principal * r / (1 - pow);\n  const rows = [];\n  let bal = principal;\n  let paid = 0;\n  for (let m = 1; m <= n; m++) {\n    const i = bal * r;\n    paid += i;\n    bal -= pay - i;\n    if (m % 60 === 0) rows.push({\n      year: m / 12,\n      interest: Math.round(paid),\n      balance: Math.round(bal),\n    });\n  }\n  return rows;\n}"
      },
      "literals": {
        "rate": 4.5,
        "years": 30
      }
    },
    {
      "id": "d-loan",
      "type": "DisplayNode",
      "x": 605,
      "y": -147,
      "init": {
        "label": "Every 5 years"
      }
    },
    {
      "id": "sc-total",
      "type": "ScriptNode",
      "x": 607,
      "y": 99,
      "init": {
        "label": "Reads the frame back",
        "expr": "(sched) => {\n  const last = sched[sched.length - 1];\n  return \"Total interest \" + last.interest;\n}"
      }
    },

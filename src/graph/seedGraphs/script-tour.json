  "nodes": [
    {
      "id": "note-head",
      "type": "NoteNode",
      "x": 0,
      "y": -360,
      "init": {
        "label": "Script: worked examples",
        "color": "amber",
        "body": "One JavaScript function per node: parameters are the inputs, the return value is the result, and the value types itself. A script can return a single value, a list, rows of values, or rows of {name: value} objects, which become a frame with typed columns. A date input arrives as its Excel serial; return a Date, or Solenoid.date(serial), to make dates. The examples below return a number, a list, a text summary, a frame, and dates.",
        "width": 560
      }
    },
    {
      "id": "in-samples",
      "type": "NumberInputNode",
      "x": 0,
      "y": 60,
      "init": {
        "label": "Samples",
        "value": 100000
      }
    },
    {
      "id": "sc-pi",
      "type": "ScriptNode",
      "x": 320,
      "y": 0,
      "init": {
        "label": "Monte Carlo π",
        "expr": "(samples) => {\n  let hits = 0;\n  for (let i = 0; i < samples; i++) {\n    const x = Math.random();\n    const y = Math.random();\n    if (x * x + y * y <= 1) hits++;\n  }\n  return 4 * hits / samples;\n}"
      }
    },
    {
      "id": "d-pi",
      "type": "DisplayNode",
      "x": 700,
      "y": 130,
      "init": {
        "label": "≈ 3.14"
      }
    },
    {
      "id": "in-n",
      "type": "NumberInputNode",
      "x": 0,
      "y": 560,
      "init": {
        "label": "27",
        "value": 27
      }
    },
    {
      "id": "sc-collatz",
      "type": "ScriptNode",
      "x": 320,
      "y": 480,
      "init": {
        "label": "Collatz path",
        "expr": "(n) => {\n  const path = [n];\n  while (n > 1 && path.length < 1000) {\n    n = n % 2 ? 3 * n + 1 : n / 2;\n    path.push(n);\n  }\n  return path;\n}"
      }
    },
    {
      "id": "spark",
      "type": "SparklineNode",
      "x": 700,
      "y": 480,
      "init": {
        "label": "Sparkline"
      }
    },
    {
      "id": "sc-summary",
      "type": "ScriptNode",
      "x": 1020,
      "y": 480,
      "init": {
        "label": "Path summary",
        "expr": "(path) => {\n  const steps = path.length - 1;\n  const peak = Math.max(...path);\n  return steps + \" steps, peak \" + peak;\n}"
      }
    },
    {
      "id": "d-summary",
      "type": "DisplayNode",
      "x": 1360,
      "y": 560,
      "init": {
        "label": "→ 111 steps, peak 9232"
      }
    },
    {
      "id": "in-principal",
      "type": "NumberInputNode",
      "x": 0,
      "y": 1000,
      "init": {
        "label": "Principal",
        "value": 250000
      }
    },
    {
      "id": "sc-loan",
      "type": "ScriptNode",
      "x": 320,
      "y": 880,
      "init": {
        "label": "Amortization table",
        "expr": "(principal, rate, years) => {\n  const r = rate / 100 / 12;\n  const n = years * 12;\n  const pow = (1 + r) ** -n;\n  const pay = principal * r / (1 - pow);\n  const rows = [];\n  let bal = principal;\n  let paid = 0;\n  for (let m = 1; m <= n; m++) {\n    const i = bal * r;\n    paid += i;\n    bal -= pay - i;\n    if (m % 60 === 0) rows.push({\n      year: m / 12,\n      interest: Math.round(paid),\n      balance: Math.round(bal),\n    });\n  }\n  return rows;\n}"
      },
      "literals": {
        "rate": 4.5,
        "years": 30
      }
    },
    {
      "id": "d-loan",
      "type": "DisplayNode",
      "x": 700,
      "y": 1000,
      "init": {
        "label": "Every 5 years"
      }
    },
    {
      "id": "in-year",

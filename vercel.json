{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "solenoid-ngc.vercel.app"
        }
      ],
      "destination": "https://solenoid-ngc.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.solenoid-ngc.com"
        }
      ],
      "destination": "https://solenoid-ngc.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/about/",
      "destination": "/about.html"
    },
    {
      "source": "/obsidian",
      "destination": "/obsidian.html"
    },
    {
      "source": "/obsidian/",
      "destination": "/obsidian.html"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/download/",
      "destination": "/download.html"
    },
    {
      "source": "/examples",
      "destination": "/examples.html"
    },
    {
      "source": "/examples/",
      "destination": "/examples.html"
    },
    {
      "source": "/packs",
      "destination": "/packs.html"
    },
    {
      "source": "/packs/",
      "destination": "/packs.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
